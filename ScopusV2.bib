@ARTICLE{Mishra2024391,
	author = {Mishra, Riya and Devi, Mayengbam Premi and Gupta, Sheetanshu and Kumar, Dhirendra},
	title = {Smart farming beyond boundaries: Global collaboration and innovation},
	year = {2024},
	pages = {391 - 405},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85205607460&partnerID=40&md5=5696c8983e487afa5b7151061ef52355},
	affiliations = {Rajmata Vijayaraje Scindia Krishi Vishwavidyalaya, Gwalior, India; Central Agricultural University Imphal, Department of Horticulture, Imphal, India; Govind Ballabh Pant University of Agriculture and Technology, Department of Biochemistry, Pantnagar, India; Ch. Bansi Lal University, Department of Botany, Bhiwani, India},
	abstract = {The "Smart Farming Beyond Boundaries: Global Collaboration and Innovation" is an engrossing story about the transforming power of smart farming, bridging national boundaries and bringing people together in a shared goal of sustainable agriculture. This shows how cutting-edge technologies like blockchain, artificial intelligence (AI), and the internet of things (IoT) can be combined to change the face of global agriculture in the future. The story follows the triumphs of cooperative projects for sustainable agriculture, transcontinental AgTech endeavours, technology transfer, and capacitybuilding initiatives, demonstrating the concrete effects of global cooperation in tackling common issues and promoting creativity. This illustrates the many dimensions of international cooperation, stressing the value of information exchange and resource sharing, from the lush fields of sustainable soil management to the dry landscapes where water-efficient agriculture practices flourish. It explores the vital role that international bodies like the Food and Agriculture Organisation and the United Nations play in realising the Sustainable Development Goals and advancing sustainable agriculture around the world. Furthermore, it emphasises how AI and IoT technologies, which offer data-driven decision-making tools and real-time insights into data, may empower farmers across borders and in a variety of geographical areas, holding the key to an agricultural revolution. This demonstrates how blockchain technology can guarantee safe and transparent food supply networks globally, lowering food fraud and improving food quality. In poor nations where smallholder farmers stand to gain from implementing these technologies, smart farming is positioned as a catalyst for global development. The story ends with a call to action that should be heeded by governments, technology companies, international development agencies, and researchers alike. Together, they should work creatively and cooperatively to create a global agriculture industry that is more integrated, efficient, and sustainable. The challenges may be substantial, but the opportunities for positive change and progress are equally profound, underscoring the promise of a world where smart farming plays a pivotal role in feeding a growing global population, conserving the environment, and fostering international development. © 2024 Elsevier B.V., All rights reserved.},
	publisher = {CRC Press},
	isbn = {9781032943367; 9781040269442},
	language = {English},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Seelam2024347,
	author = {Seelam, Dhanunjay Reddy and Kidiyur, Mridula Dileepraj and Whig, Pawan and Gupta, Shashi Kant and Balantrapu, Siva Subrahmanyam Vidya},
	title = {Integrating artificial intelligence in blue-green infrastructure: Enhancing sustainability and resilience},
	year = {2024},
	pages = {347 - 372},
	doi = {10.4018/979-8-3693-8069-7.ch016},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105008745588&doi=10.4018%2F979-8-3693-8069-7.ch016&partnerID=40&md5=08e0f666b4eba17991ddf14bd59faed5},
	affiliations = {IEEE, New York, United States; VIPS, New Delhi, India; Eudoxia Research University, Department of Computer Science and Engineering, DE, United States},
	abstract = {This chapter explores the transformative role of Artificial Intelligence (AI) in enhancing the design, implementation, and management of Blue-Green Infrastructure (BGI), a sustainable urban planning approach that integrates natural and engineered systems to address environmental challenges. The convergence of AI with BGI offers unprecedented opportunities to improve urban resilience, optimize resource management, and mitigate the impacts of climate change. Through advanced data analytics, predictive modeling, and real-time monitoring, AI-driven solutions can enhance the efficiency and effectiveness of BGI projects. This chapter delves into the various AI applications in BGI, including smart water management, flood prediction and prevention, urban heat island mitigation, and biodiversity conservation. Case studies and examples from global cities illustrate how AI is being leveraged to create more adaptive, sustainable, and resilient urban environments. The chapter also discusses the challenges and ethical considerations associated with the integration of AI in BGI, emphasizing the need for interdisciplinary collaboration and responsible AI deployment to ensure equitable and long-term benefits. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Biodiversity; Climate Change; Green Development; Sustainable Development; Urban Planning; Data Analytics; Design Implementation; Design Management; Engineered Systems; Environmental Challenges; Green Infrastructure; Natural Systems; Predictive Models; Resource Management; Urban Resilience; Predictive Analytics},
