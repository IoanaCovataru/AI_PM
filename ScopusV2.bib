@ARTICLE{Ahn2021,
	author = {Ahn, Imjin and Na, Wonjun and Kwon, Osung and Yang, Dong-hyun and Park, Gyung-min and Gwon, Hansle and Kang, Heejun and Jeong, Yeonuk and Yoo, Jungsun and Kim, Yunha},
	title = {CardioNet: a manually curated database for artificial intelligence-based research on cardiovascular diseases},
