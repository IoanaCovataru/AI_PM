	affiliations = {National Space Science Center, Beijing, China},
	abstract = {The space industry is a critical element of the overall national strategy. China upholds the principle of exploration and utilization of outer space for peaceful purposes. Advanced space science is an indispensable component of space power. At present, space science in China faces unprecedented opportunities for striding development. A series of significant successfully-operated space science missions are continuously generating a huge amount of scientific data in space science. From the data volume, velocity, and variety perspective, space science in China has entered into the big data era. With the big data, China acquired a sequence of original breakthroughs in space science in recent years. Those “new findings”, “new laws” and “new phenomena” are influential worldwide, getting much more attention to space science in China. Scientific data is considered an indispensable, fundamental, and strategic data resource serving the construction of great power of space for the Chinese government. The National Space Science Data Center (NSSDC) was jointly founded by the Ministry of Science and Technology and the Ministry of Finance in 2019. NSSDC is dedicated to space science data governance and management, promoting space science big data utilization. With the long-term efforts from the NSSDC and data scientists, China has made a sequence of fundamental progresses in governance and utilization of space science big data. More than 1.87 TB of scientific data from all kinds of major space science missions and projects have been effectively collected, classified, and unify archived, involving nearly 2100 datasets. The data resource scheme has been preliminarily generated. Totally 32 widely influential databases have been established and a large number of independent datasets are published. The data serve more than 300 projects and support thousands of outputs. The new paradigm of “space science big data plus artificial intelligence for space science” has been explored as well. More importantly, NSSDC has been approved by the CoreTrustSeal. Space science data in China begin to be worldwide attractive. The big data in space science now provides more excellent services to space science innovations and meet national strategic requirements very well. China recently is formulating medium-term and long-term development plans for space science. More and more scientific data with high quality is on its way shortly. More data means more work to be done in implementing effective data governance and more challenges exist in realizing the potential functions of those precious data resources. Considering the challenges, we present suggestions for the construction of advanced infrastructures. The suggestions involve service-oriented platforms, tools, software, and data standards. Space science big data shall be refined and better governance in further to serve data finding and utilization. The NSSDC should be continuously strengthened to better meet the demands of the research community on big data and related infrastructures. An environment system integrated the big data, powerful models, and strong computing power is needed to serve the future AI plus big data applications. In summary, it is suggested to implement more projects on big data governance in space science simultaneously with the fundamental space science missions. In such circumstances, space science big data together with the fundamental missions are expected to jointly contribute to the prompt construction of power space for China. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Big Data In Space Science; Power Of Space; Scientific Data Governance; Space Science; Utilization},
	publisher = {Chinese Academy of Sciences},
	issn = {0023074X; 20959419},
	language = {Chinese},
	type = {Note},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 3}
}

@ARTICLE{Tominc2024136,
	author = {Tominc, Polona and Oreški, Dijana and Čančer, Vesna and Rozman, Maja},
