@CONFERENCE{Purzer2024,
	author = {Purzer, Şenay Yasar and Zoltowski, Carla Bauer and Zakharov, Wei and Arigye, Joreen},
	title = {Developing the Design Reasoning in Data Life-Cycle Ethical Management Framework},
	year = {2024},
	journal = {ASEE Annual Conference and Exposition, Conference Proceedings},
	pages = {},
