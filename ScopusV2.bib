	keywords = {Cloud analytics; Cost effectiveness; Data Analytics; Digital storage; Edge computing; Fog computing; Information management; Refrigerants; Thermoelectric equipment; Two phase flow; Computing services; End-users; Hydraulic characterization; Low-GWP refrigerant; Passive cooling; Passive cooling system; Thermal hydraulics; Thermosyphon cooling; Two phases flow; Program processors},
