@CONFERENCE{Ahmad20192,
	author = {Ahmad, Muhamad Fazil and Wan Abdul Ghapar, Wan Rohila Ganti Bt},
	title = {The Era of Artificial Intelligence in Malaysian Higher Education: Impact and Challenges in Tangible Mixed-Reality Learning System toward Self Exploration Education (SEE)},
	year = {2019},
	journal = {Procedia Computer Science},
	volume = {163},
	pages = {2 - 10},
