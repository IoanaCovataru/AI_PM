}

@ARTICLE{Baghel202469,
	author = {Baghel, Randhir Singh and Rathi, Sudhir Kumar},
	title = {An artificial intelligence risk assessment of a material handling system using a cost-safety matrix},
	year = {2024},
	pages = {69 - 83},
	doi = {10.1002/9781394231126.ch4},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001757906&doi=10.1002%2F9781394231126.ch4&partnerID=40&md5=f60fd9692e393f009e2f9746abf2a40b},
	affiliations = {Poornima University, Department of Mathematics, Jaipur, India; Poornima University, Jaipur, India},
	abstract = {Cost and safety are the two main issues surrounding material handling in companies. The management considers both the safest and quickest route during transit in addition to the cost. The path that is chosen based on safety assessments and the cost of transportation for each route will be covered in this chapter. The Cost-Safety matrix for risk analysis of transportation pathways will be introduced in this chapter. The safety matrix is tied to the path (route), and the cost matrix is related to the transportation cost element. The cost-safety matrix considers both the risk associated with a certain path and the expense of that approach. Using historical data, a numeric range of values is allocated to create the risk matrix. A three-part matrix is created by combining the risk level and the cost of transportation. Low, moderate, and highrisk levels are the categories used to describe them. This matrix may be used to select the route before the transport is started. The incorporation of artificial intelligence (AI) into material handling procedures is essential for maximizing productivity and guaranteeing worker security. With a major focus on recognizing and minimizing possible dangers connected with lifting, moving, and managing goods, this research focuses on the use of AI in the risk assessment of material handling jobs. The study analyzes enormous datasets on material handling activities using sensor technologies, data analytics, and machine learning algorithms. The goal of the project is to create a strong risk assessment system that can automatically identify, anticipate, and reduce possible dangers related to falling objects, collapsing loads, inappropriate lifting procedures, and struck-by hazards by utilizing artificial intelligence (AI). © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Cost-safety Matrix; Material Handling; Risk Analysis; Transportation},
	publisher = {wiley},
	isbn = {9781394231126; 9781394231096},
	language = {English},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1}
}

