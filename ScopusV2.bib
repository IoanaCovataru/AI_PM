	keywords = {Budget control; Case based reasoning; Computational cost; Cost accounting; Cost benefit analysis; Decision trees; Project management; Supervised learning; Artificial intelligence methods; Artificial intelligence techniques; Conceptual cost estimates; Conceptual cost estimation; Construction projects; Estimation techniques; Initiation phase; Performance; Project initiations; Systematic literature review; Cost estimating},
