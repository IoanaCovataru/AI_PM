	doi = {10.1109/MNET.2024.3421940},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85197508880&doi=10.1109%2FMNET.2024.3421940&partnerID=40&md5=0c9e740484ab1c850c5e466816557f31},
