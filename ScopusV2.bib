@ARTICLE{Chatzipanagiotou20241994,
	author = {Chatzipanagiotou, Odysseas P. and Loukas, Constantinos G. and Vailas, Michail G. and Machairas, Nikolaos A. and Kykalos, Stylianos and Charalampopoulos, Georgios and Filippiadis, Dimitrios K. and Felekouras, Evangelos S. and Schizas, Dimitrios N.},
	title = {Artificial intelligence in hepatocellular carcinoma diagnosis: a comprehensive review of current literature},
	year = {2024},
	journal = {Journal of Gastroenterology and Hepatology (Australia)},
	volume = {39},
	number = {10},
	pages = {1994 - 2005},
	doi = {10.1111/jgh.16663},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85196643813&doi=10.1111%2Fjgh.16663&partnerID=40&md5=266badef4f385c49a9cc26e1d70f7407},
	affiliations = {National and Kapodistrian University of Athens, Department of Surgery, Athens, Greece; School of Medicine, Medical Physics Laboratory, Athens, Greece; National and Kapodistrian University of Athens, Second Department of Propaedeutic Surgery, Athens, Greece; National and Kapodistrian University of Athens, Department of Radiology, Athens, Greece},
	abstract = {Background and Aim: Hepatocellular carcinoma (HCC) diagnosis mainly relies on its pathognomonic radiological profile, obviating the need for biopsy. The project of incorporating artificial intelligence (AI) techniques in HCC aims to improve the performance of image recognition. Herein, we thoroughly analyze and evaluate proposed AI models in the field of HCC diagnosis. Methods: A comprehensive review of the literature was performed utilizing MEDLINE/PubMed and Web of Science databases with the end of search date being the 30th of September 2023. The MESH terms “Artificial Intelligence,” “Liver Cancer,” “Hepatocellular Carcinoma,” “Machine Learning,” and “Deep Learning” were searched in the title and/or abstract. All references of the obtained articles were also evaluated for any additional information. Results: Our search resulted in 183 studies meeting our inclusion criteria. Across all diagnostic modalities, reported area under the curve (AUC) of most developed models surpassed 0.900. A B-mode US and a contrast-enhanced US model achieved AUCs of 0.947 and 0.957, respectively. Regarding the more challenging task of HCC diagnosis, a 2021 deep learning model, trained with CT scans, classified hepatic malignant lesions with an AUC of 0.986. Finally, a MRI machine learning model developed in 2021 displayed an AUC of 0.975 when differentiating small HCCs from benign lesions, while another MRI-based model achieved HCC diagnosis with an AUC of 0.970. Conclusions: AI tools may lead to significant improvement in diagnostic management of HCC. Many models fared better or comparable to experienced radiologists while proving capable of elevating radiologists' accuracy, demonstrating promising results for AI implementation in HCC-related diagnostic tasks. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Diagnosis; Hcc; Models; Radiomics; Biological Marker; Area Under The Curve; Artificial Intelligence; Cancer Diagnosis; Computer Assisted Tomography; Deep Learning; Endoscopy; Histopathology; Human; Liver Cell Carcinoma; Machine Learning; Medline; Nuclear Magnetic Resonance Imaging; Radiologist; Radiomics; Review; Web Of Science; Diagnosis; Diagnostic Imaging; Echography; Liver Tumor; Pathology; X-ray Computed Tomography; Area Under Curve; Artificial Intelligence; Carcinoma, Hepatocellular; Deep Learning; Humans; Liver Neoplasms; Machine Learning; Magnetic Resonance Imaging; Tomography, X-ray Computed; Ultrasonography},
	keywords = {biological marker; area under the curve; artificial intelligence; cancer diagnosis; computer assisted tomography; deep learning; endoscopy; histopathology; human; liver cell carcinoma; machine learning; Medline; nuclear magnetic resonance imaging; radiologist; radiomics; Review; Web of Science; diagnosis; diagnostic imaging; echography; liver tumor; pathology; x-ray computed tomography; Area Under Curve; Artificial Intelligence; Carcinoma, Hepatocellular; Deep Learning; Humans; Liver Neoplasms; Machine Learning; Magnetic Resonance Imaging; Tomography, X-Ray Computed; Ultrasonography},
	publisher = {John Wiley and Sons Inc},
	issn = {14401746; 08159319},
	coden = {JGHEE},
	pmid = {38923550},
	language = {English},
	type = {Review},
	publication_stage = {Final},
