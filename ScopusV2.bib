@ARTICLE{Abdel-Kader2022,
	author = {Abdel-Kader, Mohamed Y. and Ebid, Ahmed M. and Onyelowe, Kennedy Chibuzor and Mahdi, Ibrahim Mahmoud and Abdul-Rashied, Ibrahim},
