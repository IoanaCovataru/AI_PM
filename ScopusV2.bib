	title = {Successful Reservoir Management and Optimization of Mature Steamflood Projects Using Artificial Intelligence},
	year = {2022},
	journal = {SPE Annual Technical Conference Proceedings},
	volume = {2022-October},
	pages = {},
	doi = {10.2118/209988-MS},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85139703626&doi=10.2118%2F209988-MS&partnerID=40&md5=a0328405ebb8d4a0b3b31d4ba88094a4},
	affiliations = {Chevron Technology Center; Chevron North America Exploration & Production},
	abstract = {The reservoir management processes of heavy oil reservoirs are challenging and require different types of considerations when contrasted to conventional reservoirs. The development and optimization of heavy oil thermal EOR projects entails the injection of steam through dedicated injectors to assure the viscosity reduction necessary for the oil to freely flow thorough the porous media into the producing wells. The four stages of a steamflood development project consist of ramp-up, peak and plateau, decline and tail-end production. Optimization of each stage is critical for the success of the project. The current study addresses the tail-end stage of the steamflood project and focuses on the optimization component of steam used, particularly steam reduction, within reservoir management practices. The novel approach presented in this work allows successful identification of mature areas within the reservoir and/or projects that are ready and would benefit from significant steam reduction. The methodology uses heat management knowledge, large datasets, and artificial intelligence (AI) technologies. The workflow exploits the log data, existing full-field earth model, the current steamflood conditions, and automates the screening and ranking of maturity of development patterns in large heavy oilfields. The methodology outperformed the previous manual approach, not only by better identifying areas and opportunities, but also optimizing the steam reduction schedule, and in certain cases recommending steam redeployment to potentially increase field production. © 2022 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Crude Oil; Gasoline; Heavy Oil Production; Injection (oil Wells); Large Dataset; Petroleum Reservoir Evaluation; Porous Materials; Steam; 'current; Development Programmes; Heavy Oil Reservoirs; Management Process; Optimisations; Porous Medium; Steam Reduction; Steamflood; Thermal; Viscosity Reduction; Reservoir Management},
	keywords = {Artificial intelligence; Crude oil; Gasoline; Heavy oil production; Injection (oil wells); Large dataset; Petroleum reservoir evaluation; Porous materials; Steam; 'current; Development programmes; Heavy oil reservoirs; Management process; Optimisations; Porous medium; Steam reduction; Steamflood; Thermal; Viscosity reduction; Reservoir management},
