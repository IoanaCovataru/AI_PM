@ARTICLE{Zhang2023519,
	author = {Zhang, Shao and Xu, Hui and Jia, Yuting and Wen, Ying and Wang, Dakuo and Fu, Luoyi and Wang, Xinbing and Zhou, Chenghu},
	title = {GeoDeepShovel: A platform for building scientific database from geoscience literature with AI assistance},
	year = {2023},
	journal = {Geoscience Data Journal},
	volume = {10},
	number = {4},
	pages = {519 - 537},
	doi = {10.1002/gdj3.186},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85149956803&doi=10.1002%2Fgdj3.186&partnerID=40&md5=cd50951311d9214afb5dea417d36db7e},
	affiliations = {Shanghai Jiao Tong University, Shanghai, China; IBM Research, Yorktown Heights, United States; Institute of Geographic Sciences and Natural Resources Research, Chinese Academy of Sciences, Beijing, China},
	abstract = {With the rapid development of big data science, the research paradigm in the field of geosciences has also begun to shift to big data-driven scientific discovery. Researchers need to read a huge amount of literature to locate, extract and aggregate relevant results and data that are published and stored in PDF format for building a scientific database to support the big data-driven discovery. In this paper, based on the findings of a study about how geoscientists annotate literature and extract and aggregate data, we proposed GeoDeepShovel, a publicly available AI-assisted data extraction system to support their needs. GeoDeepShovel leverages state-of-the-art neural network models to support researcher(s) easily and accurately annotate papers (in the PDF format) and extract data from tables, figures, maps, etc., in a human–AI collaboration manner. As a part of the Deep-Time Digital Earth (DDE) program, GeoDeepShovel has been deployed for 8 months, and there are already 400 users from 44 geoscience research teams within the DDE program using it to construct scientific databases on a daily basis, and more than 240 projects and 50,000 documents have been processed for building scientific databases. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Big Data-driven Discovery; Data Extraction; Human-computer Interaction; Scientific Database; Artificial Intelligence; Artificial Neural Network; Data Management; Database; Earth Science; Research Institution},
