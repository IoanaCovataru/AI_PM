	title = {AI-Integrated Cyber Security Risk Management Framework for IT Projects},
	year = {2024},
	pages = {76 - 81},
	doi = {10.1109/IJCC64742.2024.10847294},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85218026104&doi=10.1109%2FIJCC64742.2024.10847294&partnerID=40&md5=b2f2866eeae9f22f9e46426fae79071c},
