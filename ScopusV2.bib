}

@CONFERENCE{Buyones-Gonzalez2024,
	author = {Buyones-Gonzalez, Hector and Quezada-Espinoza, Monica},
	title = {Artificial Intelligence in the Construction Industry: A Competency-Based Examination Through Expert Lens},
	year = {2024},
