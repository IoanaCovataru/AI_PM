@ARTICLE{Galleguillos Rosales2024241,
	author = {Galleguillos Rosales, Alejandro Andrés and González León, Alfredo and Galleguillos Rosales, Ingrid Luisa},
	title = {Design of a Technological System with Artificial Intelligence to Manage Projects Through the Use of Knowledge Management and Lessons Learned},
	year = {2024},
	journal = {Studies in Computational Intelligence},
