@CONFERENCE{Affaitati2024,
	author = {Affaitati, Francesco},
	title = {Automation in operations for Earth bound satellites - State of the art and prospective},
	year = {2024},
	pages = {},
	doi = {10.2514/6.2024-4806},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85204202303&doi=10.2514%2F6.2024-4806&partnerID=40&md5=6d3fb3eadbad1aa9837f45f82b2056dd},
	affiliations = {European Space Operations Centre, Darmstadt, Germany; Ground Segment Operations Dept, Darmstadt, Hessen, Germany},
	abstract = {To date, the European Space Operations Centre (ESOC) locate in Darmstadt (Germany) - operated more the 60 earth observation satellite, an average of one new satellite for Earth observation a year, since the foundation of the Centre. Several of these satellites are still in operation either with ESOC or with our partner organizations e.g. Eumetsat. And among them, 16 satellite are under direct ESOC operational control. In more the 60 years of operations, ESOC and the Flight Dynamics unit cumulated a huge amount of knowledge capital, done of people knowhow, system design and procedures. From mission dedicated teams and systems, we evolved toward a more complex multi-mission environment where teams and systems operates more then a single spacecraft. Earth satellite project are not all the same in terms of Ground Control concept: we range from typical ground track control, to tandem control with collaborative spacecraft, where the operational concept start to diverge quite a bit from classical polar orbiter. Today the Flight Dynamics Earth Observation operates 16 spacecraft in a shared environment. On top of this the Unit provides external support to other earth bound missions operated by partners. A good fraction of the 16 spacecraft comes from the EU Copernicus Program, where ESA supported not only the development of the Sentinels constellations, but also the operations form launch to commissioning and routine. At present ESA/ESOC operates Sentinel 1 and 2 constellations, plus Sentinel 5P the Precursor, but also old glories like XMM and Integral observatory missions. Launch end early orbit operations is certainly a delicate phase, but it is the routine one that brings most of the operational effort and budget, so it is clear that the routine operation are the one where most of the effort is spent in order to achieve as much as possible automation. And today overall the routine operations for our 16+ spacecrafts involves only 25 people part-time (50%), so less then a person per spacecraft in average. This paper would like to present the status of the art of the automation achieved in the Flight Dynamics Division for the control of earth bound satellites, highlight the challenges, the benefits, and future trends. Automation in the Flight Dynamics operations are described at a level of sub-system architecture together with the interfaces with other essential Ground Segment systems. Challenges are investigated starting from the mission concept side where different spacecraft platforms and operational modes are operated; the maintenance strategy options are then addressed which have an impact on the operational mode and procedures. The contribution of standardization efforts are also investigated to achieve harmonization and optimal maintenance strategies a key factor to foster automation. Finally future trends are then described and the main aspects in automation are identified to enable the adoption of higher degree of automation together with Artificial Intelligence support, for the future to come. © 2024 Elsevier B.V., All rights reserved.},
