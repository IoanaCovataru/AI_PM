	title = {An assessment of the European Patient Summary for clinical research: a case study in cardiology},
	year = {2024},
	journal = {Frontiers in Medicine},
	volume = {11},
	pages = {},
	doi = {10.3389/fmed.2024.1481551},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85210081318&doi=10.3389%2Ffmed.2024.1481551&partnerID=40&md5=40c4e2b7ad218c7e02325cbcb52a60fa},
	affiliations = {SRDC Software Research & Development and Consultancy Corp., Ankara, Turkey; Universiteit van Amsterdam, Department of Cardiology, Amsterdam, Netherlands; Universiteit van Amsterdam, Department of Medical Informatics, Amsterdam, Netherlands; Amsterdam Cardiovascular Sciences, Amsterdam, Netherlands; Universitat de Barcelona, Facultat de Matemàtiques i Informàtica, Barcelona, Spain; Institució Catalana de Recerca i Estudis Avançats, Barcelona, Spain; HL7 Europe, Brussels, Belgium; Clinical Data Interchange Standards Consortium, Austin, United States},
	abstract = {Introduction: The European Health Data Space (EHDS) initiative was launched to create a unified framework for health data exchange across Europe. Central to this initiative is the European Electronic Health Record Exchange Format, designed to achieve interoperability of electronic health record data across Europe. Despite these advancements, the readiness of current guidelines and implementations, such as the European Patient Summary, to support secondary use in clinical research, particularly in cardiology, remains underexplored. Methods: This study aims to evaluate the European Patient Summary guidelines and their implementations, specifically the HL7 FHIR International Patient Summary Implementation Guide, to determine their suitability for secondary use in clinical research. The focus is on identifying gaps and extensions needed to enhance the utility of the European Patient Summary for building artificial intelligence models in assisting heart failure management. Results: We selected two European Union-funded research projects, DataTools4Heart and AI4HF, that aim to reuse electronic health record data to develop artificial intelligence models for personalized decision support services for heart failure patients. We analyzed their clinical use cases and the specific data items required, and we compared these with the current European Patient Summary guidelines and provided a detailed gap analysis indicating similarities and required extensions. In our gap analysis, we also compared the needs of DataTools4Heart and AI4HF with the HL7 FHIR International Patient Summary Implementation Guide to assess the extensions needed to support clinical research. Discussion: The EHDS is a transformative initiative to establish a European health data ecosystem that supports healthcare delivery and clinical research. Our comparative analysis demonstrates that, with minor extensions, these guidelines have significant potential to facilitate access to electronic healthcare record data for the secondary use, particularly in training AI models. We advocate for the adoption of an International Patient Summary format as a semantically interoperable core set of data elements, which will enhance global clinical research efforts and improve patient outcomes through precision medicine. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Clinical Research; Common Data Model; Health Ecosystem; Interoperability; Secondary Use Of Ehr Data; Cardiac Agent; Article; Artificial Intelligence; Cardiology; Case Study; Cause Of Death; Clinical Decision Support System; Clinical Research; Controlled Study; Diastolic Blood Pressure; Drug Dose Regimen; Drug Use; Electronic Health Record; Employment Status; European; Fast Healthcare Interoperability Resources; Heart Failure; Heart Rate; Hospital Discharge; Human; Laboratory Test; Logical Observation Identifiers Names And Codes; Major Clinical Study; Medical Record Review; Oxygen Saturation; Patient Information; Personalized Medicine; Social Status; Systolic Blood Pressure; Vital Sign},
	keywords = {cardiac agent; Article; artificial intelligence; cardiology; case study; cause of death; clinical decision support system; clinical research; controlled study; diastolic blood pressure; drug dose regimen; drug use; electronic health record; employment status; European; Fast Healthcare Interoperability Resources; heart failure; heart rate; hospital discharge; human; laboratory test; Logical Observation Identifiers Names and Codes; major clinical study; medical record review; oxygen saturation; patient information; personalized medicine; social status; systolic blood pressure; vital sign},
	publisher = {Frontiers Media SA},
	issn = {2296858X},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 1; All Open Access; Gold Open Access}
}

@ARTICLE{Stephen2024181,
	author = {Stephen, Seyi Segun and Oke, Ayodeji Emmanuel and Clinton, Aigbavboa Ohis},
	title = {Integration of Industry 5.0 Principles in Stealth Construction: Leveraging Emerging Technologies for Efficiency and Sustainability},
	year = {2024},
	journal = {Studies in Systems, Decision and Control},
	volume = {565},
	pages = {181 - 197},
	doi = {10.1007/978-3-031-70996-8_9},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85210012545&doi=10.1007%2F978-3-031-70996-8_9&partnerID=40&md5=68d6065483c934f1f2bca6912d112423},
	affiliations = {University of Johannesburg, Sustainable Human Settlement and Construction Research Centre, Johannesburg, South Africa},
	abstract = {This study investigated how integrating Industry 5.0 principles with stealth construction methodologies enhances efficiency and sustainability in the construction sector. With rapid advancements in emerging technologies, the construction industry must incorporate Industry 5.0 concepts, emphasising human–machine collaboration and connectivity. Construction processes can become smarter and more adaptive by adopting stealth construction techniques, which prioritise the integration of digital construction in construction practices alongside Industry 5.0 principles. Leveraging cutting-edge technologies such as the Internet of Things (IoT), Building Information Modelling (BIM), and Artificial Intelligence (AI) across construction practices like lean construction, value management, and supply chain management (SCM), among others, this concept propels the construction industry towards resource utilisation, streamlined project management, and reduced construction duration. Moreover, incorporating sustainable materials and energy-efficient design strategies further contributes to the environmental resilience of construction projects. Through a comprehensive discussion on fusing these concepts towards a functional and resilient construction industry, the chapter elucidates the potential benefits and challenges of integrating Industry 5.0 principles in stealth construction across construction phases. Ultimately, this novel approach offers actionable insights for industry stakeholders to harness the transformative power of emerging technologies towards building a more efficient and sustainable environment. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Digital Construction; Emerging Technologies; Environmental Resilience; Industry 5.0; Stealth Construction; Sustainability},
	publisher = {Springer Science and Business Media Deutschland GmbH},
	issn = {21984190; 21984182},
	isbn = {9783319432700},
	language = {English},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 2}
}

@ARTICLE{Ding2024,
	author = {Ding, Yan and Zhang, Liyuan and Zhai, Yujuan and Pan, Lin and Zhao, Jia},
	title = {Provisioning Optimization of Construction Resources: A Human-Centric Multi-Objective Computational Intelligence Fusion Approach with AI Evaluation Techniques},
	year = {2024},
	journal = {Human-centric Computing and Information Sciences},
	volume = {14},
	pages = {},
	doi = {10.22967/HCIS.2024.14.062},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85209989039&doi=10.22967%2FHCIS.2024.14.062&partnerID=40&md5=6039ff90ed4d85246ab2a1806ec27fab},
	affiliations = {Changchun Institute of Technology, College of Artificial Intelligence Technology & School of Computer Technology and Engineering, Changchun, China; Changchun University of Technology, School of Chemistry and Life Science, Changchun, China; Peking University, Beijing, China},
	abstract = {The management of various tasks on the construction site mostly relies on the experience of managers, but this experiential management is often not the optimal solution. The implementation of a people-centered on-site management method plays a crucial role in providing managers with the optimal solution. In this paper, we presented a human-centric construction resource provisioning approach (CRA-AO) that combines computational intelligence with artificial intelligence (AI) methods to enhance the efficiency of resource allocation in construction projects while providing evaluation feedback. The proposed approach consists of two main parts. First, the concept of time series window is employed to incorporate various construction activities and human resources in the construction network diagram (i.e., an AOV network), leading to the optimal human resource allocation plan using an improved Aquila optimizer. Second, an AI-based method is proposed to train construction quality standards and actual quality parameters through a deep auto-coder, comparing the similarity analysis of the training results. We use actual project time and cost data for analysis and compare it with the cost related index of traditional construction schemes. The experimental results demonstrate that the proposed CRA-AO approach effectively optimizes construction resource allocation and quality evaluation, enabling a robust project schedule and cost adjustments, while achieving optimized management of construction sites in projects. This research highlights the importance of human-centric computing and information science in developing intelligent, adaptive solutions for construction engineering challenges. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Ai Evaluation Techniques; Automatic Parallelization Model; Construction Cost Management; Human-centric Fusion Computing; Manpower Provisioning Optimization; Cost Engineering; Information Management; Personnel Training; Project Management; Quality Management; Resource Allocation; Artificial Intelligence Evaluation Technique; Automatic Parallelization; Automatic Parallelization Model; Construction Cost Managements; Construction Resource; Construction Sites; Human-centric; Human-centric Fusion Computing; Manpower Provisioning Optimization; Optimisations; Cost Benefit Analysis},
	keywords = {Cost engineering; Information management; Personnel training; Project management; Quality management; Resource allocation; Artificial intelligence evaluation technique; Automatic Parallelization; Automatic parallelization model; Construction cost managements; Construction resource; Construction sites; Human-centric; Human-centric fusion computing; Manpower provisioning optimization; Optimisations; Cost benefit analysis},
	publisher = {Korea Information Processing Society},
	issn = {21921962},
	language = {English},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

@ARTICLE{Santos-Gonçalves2024129,
	author = {Santos-Gonçalves, Tatiana},
	title = {Local Media in the Age of AI},
	year = {2024},
	pages = {129 - 139},
	doi = {10.1201/9781003473633-12},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85209854351&doi=10.1201%2F9781003473633-12&partnerID=40&md5=d930da1170d006bb36ad672de45532b9},
	affiliations = {Universidad Miguel Hernández de Elche, Elche, Spain},
	abstract = {The recent rapid development of artificial intelligence (AI) technologies has been greatly disrupted, creating both significant challenges and opportunities for media organizations. On the one hand, the widespread use of these technologies might open new possibilities for expanding media options, such as personalization for user engagement or developing data-driven journalism for news stories. However, a rising number of academics are warning about the risks of using these technologies, including the spread of misinformation, digital exclusion, foreign manipulation in political processes, and polarization of society. Most AI news initiatives rely on funding from tech giants like Microsoft, Facebook, or Google. This restricts the design of AI in the news sector to a select few players. These issues are particularly important for small newsrooms, as local and regional media have typically played an essential public service and cannot compete in technological resources with larger media corporations. Obviously, the use of an AI system would simplify the tasks of the already overloaded local journalists in local outlets, but it could also disincentive critical thinking and jeopardize their editorial independence. For all these reasons it is essential that local and regional media organizations develop their own AI solutions beyond large media and big corporations so that they can achieve their strategic goals and protect their values and editorial independence. However, if they do that they would become “providers” according to the European AI Act draft and therefore would have to deal with all the legal responsibilities that come with this. Again, this will create additional challenges considering the scarce resources of local media when compared with large media organizations. In any case, if small media organizations want to survive, then they need to understand the new dynamics and possibilities of AI for the media, and so researchers and academics must play a central role to develop the potential of AI for local outlets. An interesting initiative in this direction is a partnership of Bristol Cable, the Bureau of Investigative Journalism, and the German CORRECTIV, called beabee, aiming to develop a content management system for local newsrooms to remain local, community-driven, and independent newsrooms. To bring more diversity and financial stability to our local information ecosystems it is an essential step-change in audience engagement and revenue. One of the ideas of this project is to look for a business model based on memberships and donations. To this end, it is essential for local journalism to build and maintain the trust with the readers, keeping in constant touch with the audience. To achieve these goals and compete with larger media organizations, it will be necessary to design and build a careful AI system tailor-made for local media. In this chapter we analyse all these issues and discuss what small independent community media organizations can reshape in our media ecosystem to achieve their strategic goals within a new scenario where AI technologies will certainly bring about a profound disruption in the way media operates. The chapter concludes with an agenda for future research. © 2024 Elsevier B.V., All rights reserved.},
	publisher = {CRC Press},
	isbn = {9781032733425; 9781040159934},
	language = {English},
	type = {Book chapter},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

