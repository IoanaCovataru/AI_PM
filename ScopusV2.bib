@ARTICLE{Gorain2021153,
	author = {Gorain, Barun K.},
	title = {Leveraging physical, digital and knowledge connectivity for smart villages},
	year = {2021},
	pages = {153 - 175},
	doi = {10.1007/978-3-030-68458-7_13},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85150311953&doi=10.1007%2F978-3-030-68458-7_13&partnerID=40&md5=04f9fb520c5b0d36001644991212950e},
	affiliations = {Ore2Metal Inc, Toronto, Canada},
	abstract = {Rapid advancements in digital technologies have allowed smart villages to take shape in various countries across the globe, though mostly in conceptual, research or initial implementation stages. The common evolving theme is that smart villages be looked at holistically with a focus on improving the quality of life in rural communities. Building the foundation is the key based on sustainable principles laid out by communities and key stakeholders through co-creation to suit the specific needs of people's aspiration and respecting the geography and the environment that surrounds the community. A digital technology framework has been proposed to look at smart villages strategically with clarity on short-term and long-term goals coupled with high potential projects and their successful implementation for maximizing the benefits from smart villages. New digital technologies such as Cloud Computing, Blockchain, Robotics, Data Analytics, Artificial intelligence (AI), Internet of Things (IoT) and 5G are increasingly being implemented across various sectors and they present significant opportunities for the rural sector to improve quality of life in smart villages. It is still the early days, but it appears that European Union's ENRD (European Network for Rural Development) has made some major advancements in the implementation of various strategic smart village concepts at many of their member countries. Several references from ENRD has been made with the assumption that some of the key learnings from Europe could be leveraged by other countries aspiring to build smart villages. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Change Management; Digital Divide; Digital Literacy; Digital Transformation; European Network For Rural Development (enrd); Living Labs; Technology Framework},
