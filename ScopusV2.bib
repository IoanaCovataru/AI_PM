	title = {Cold Plate Liquid Cooling Solution for Hot-swapped Components in Server System},
	year = {2024},
	journal = {InterSociety Conference on Thermal and Thermomechanical Phenomena in Electronic Systems, ITHERM},
	pages = {},
	doi = {10.1109/ITherm55375.2024.10709461},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85207820559&doi=10.1109%2FITherm55375.2024.10709461&partnerID=40&md5=af1a359f4f6b518898978ca73abb9e53},
	affiliations = {Intel Corporation, China, Beijing, China},
	abstract = {With the explosive growth in demand for artificial intelligence (AI) and machine leaning(ML), the CPU/GPU Thermal Design Power(TDP) is continuous increasing generation by generation in server system. Liquid cooling solution is becoming irreplaceable solution with its benefit of energy usage efficiency compared with air cooling system in current datacenter server systems. The cold plate liquid cooling solution is widely used in industry to deal with increasing system level cooling challenges with improved Power Usage Effectiveness (PUE). For a cold plate liquid cooling server system, the ideal solution would be all components in the server can be liquid cooled in order to get 100% heat capture ratio(HCR). In the real products, the main components such as CPU/memories can be liquid cooled, but other components such as IO card, SSD may still be air cooled. There are many technical challenges to use liquid cooling cold plate to cover these components for many reasons, such as mechanical limitation, different form factors, hot swap requirement etc. This paper proposes a total thermal/mechanical cold plate cooling solution to solve such challenges in SSD and IO module with various form factor and hot swapped demand. Two-piece parts of cooling solution are designed. One part with heat pipe embedded in the hot swapped components and one part with liquid channel cold plate. With two parts docking mechanism, the cooling path from hot components to the liquid is created. The thermal analysis and mechanical design concept are introduced in this paper. A prototype sample in the POC (proof of concept) project is tested to verify the concept and solution. The proposed cooling solution can keep the target components within their thermal spec and meet close to 100% heat capture to liquid cooling loop, which maximizes the energy efficiency for the cold plate liquid cooling server. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Cold Plate; Hot Swapped; Liquid Cooling; Computer Resource Management; Electronics Packaging; Patternmaking; Cold Plates; Cooling Solutions; Form Factors; Hot Swapped; Liquid Cooled; Liquid Cooling; Mechanical; One Parts; Server System; Thermal; Melt Spinning},
