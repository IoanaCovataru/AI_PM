@ARTICLE{Vial2023669,
	author = {Vial, Gregory and Cameron, Ann Frances and Giannelia, Tanya and Jiang, Jinglu},
	title = {Managing artificial intelligence projects: Key insights from an AI consulting firm},
	year = {2023},
	journal = {Information Systems Journal},
	volume = {33},
	number = {3},
	pages = {669 - 691},
	doi = {10.1111/isj.12420},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85145047621&doi=10.1111%2Fisj.12420&partnerID=40&md5=4e07ab7e6f2f0bef66301591b733a991},
	affiliations = {HEC Montréal, Department of Information Technology, Montreal, Canada; Binghamton University State University of New York, Binghamton, United States},
	abstract = {While organisations are increasingly interested in artificial intelligence (AI), many AI projects encounter significant issues or even fail. To gain a deeper understanding of the issues that arise during these projects and the practices that contribute to addressing them, we study the case of Consult, a North American AI consulting firm that helps organisations leverage the power of AI by providing custom solutions. The management of AI projects at Consult is a multi-method approach that draws on elements from traditional project management, agile practices, and AI workflow practices. While the combination of these elements enables Consult to be effective in delivering AI projects to their customers, our analysis reveals that managing AI projects in this way draw upon three core logics, that is, commonly shared norms, values, and prescribed behaviours which influence actors' understanding of how work should be done. We identify that the simultaneous presence of these three logics—a traditional project management logic, an agile logic, and an AI workflow logic—gives rise to conflicts and issues in managing AI projects at Consult, and successfully managing these AI projects involves resolving conflicts that arise between them. From our case findings, we derive four strategies to help organisations better manage their AI projects. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Agile; Ai Workflow; Artificial Intelligence; Institutional Logic; Project Management; Artificial Intelligence; Computer Circuits; Agile; Agile Practices; Artificial Intelligence Workflow; Consulting Firms; Custom Solutions; Institutional Logic; Multi-method Approach; North American; Power; Work-flows; Project Management},
