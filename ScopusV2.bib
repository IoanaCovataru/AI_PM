	keywords = {Asset management; Clinical research; Costs; Diagnosis; Empowerment of personnel; Failure analysis; Fault tolerance; Flowlines; Oncology; Outages; Pipeline codes; Project management; Reliability analysis; Six sigma; Strategic planning; Waste treatment; Artificial intelligence technologies; Assets management; Condition assessments; Infrastructure managements; Manual inspection; Operational efficiencies; Pipe defect coding; Pipe defects; Sewer inspection; Sewer rehabilitation; Efficiency},
	publisher = {Water Environment Federation},
	language = {English},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 0}
}

