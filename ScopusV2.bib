@ARTICLE{Ahun2023,
	author = {Ahun, Erhan and Demir, Ahmet and Yiǧit, Yavuz and Tulgar, Yasemin Koçer and Doğan, Meltem and Thomas, David Terence and Tulgar, Serkan},
	title = {Perceptions and concerns of emergency medicine practitioners about artificial intelligence in emergency triage management during the pandemic: a national survey-based study},
	year = {2023},
	journal = {Frontiers in Public Health},
	volume = {11},
	pages = {},
	doi = {10.3389/fpubh.2023.1285390},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85176936420&doi=10.3389%2Ffpubh.2023.1285390&partnerID=40&md5=599f9374566f85cafb18eb79a4cd4414},
	affiliations = {Sabuncuoğlu Şerefeddin Training and Research Hospital, Department of Emergency Medicine, Amasya, Turkey; Muğla Sıtkı Koçman Üniversitesi, Department of Emergency Medicine, Mugla, Turkey; Hamad Medical Corporation, Department of Emergency Medicine, Doha, Qatar; Barts and The London School of Medicine and Dentistry, London, United Kingdom; Samsun University, Department of Medical History and Ethics, Samsun, Turkey; Kocaeli Üniversitesi, Department of History of Medicine and Ethics, İzmit, Turkey; T.C. Maltepe Universitesi Tip Fakültesi, Department of Medical Education, Istanbul, Turkey; T.C. Maltepe Universitesi Tip Fakültesi, Department of Pediatric Surgery, Istanbul, Turkey; Samsun University, Department of Anesthesiology, Samsun, Turkey},
	abstract = {Objective: There have been continuous discussions over the ethics of using AI in healthcare. We sought to identify the ethical issues and viewpoints of Turkish emergency care doctors about the use of AI during epidemic triage. Materials and methods: Ten emergency specialists were initially enlisted for this project, and their responses to open-ended questions about the ethical issues surrounding AI in the emergency room provided valuable information. A 15-question survey was created based on their input and was refined through a pilot test with 15 emergency specialty doctors. Following that, the updated survey was sent to emergency specialists via email, social media, and private email distribution. Results: 167 emergency medicine specialists participated in the study, with an average age of 38.22 years and 6.79 years of professional experience. The majority agreed that AI could benefit patients (54.50%) and healthcare professionals (70.06%) in emergency department triage during pandemics. Regarding responsibility, 63.47% believed in shared responsibility between emergency medicine specialists and AI manufacturers/programmers for complications. Additionally, 79.04% of participants agreed that the responsibility for complications in AI applications varies depending on the nature of the complication. Concerns about privacy were expressed by 20.36% regarding deep learning-based applications, while 61.68% believed that anonymity protected privacy. Additionally, 70.66% of participants believed that AI systems would be as sensitive as humans in terms of non-discrimination. Conclusion: The potential advantages of deploying AI programs in emergency department triage during pandemics for patients and healthcare providers were acknowledged by emergency medicine doctors in Turkey. Nevertheless, they expressed notable ethical concerns related to the responsibility and accountability aspects of utilizing AI systems in this context. © 2023 Elsevier B.V., All rights reserved.},
	author_keywords = {Ai; Emergency; Ethics; National; Pandemic; Specialist; Survey; Triage; Article; Artificial Intelligence; Artificial Intelligence Software; Deep Learning; Emergency Care; Emergency Medicine; Emergency Physician; Emergency Ward; Epidemic; Health Care Personnel; Human; Medical Specialist; Pandemic; Patient Triage; Perception; Physician; Pilot Study; Privacy; Social Media; Adult; Artificial Intelligence; Delivery Of Health Care; Emergency Medicine; Humans; Pandemics; Triage},
