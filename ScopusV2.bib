	pages = {},
	doi = {10.1016/j.asej.2024.102941},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85198178199&doi=10.1016%2Fj.asej.2024.102941&partnerID=40&md5=07a71a1f1a1757f9def599f4f4f95756},
	affiliations = {Nanjing University of Post and TeleCommunications, School of Computer Science, Nanjing, China; Samueli School of Engineering, Irvine, United States; Guangxi Medical University, School of Information and Management, Nanning, China; Guangxi Medical University, School of Humanities and Social Sciences, Nanning, China},
	abstract = {A new paradigm for supporting medical services, especially beneficial for metropolitan regions and individuals experiencing homelessness who use technological communications, is fog-based healthcare service management integrated with the Internet of Things (IoT). This paradigm allows for the flexible transformation of health data into personalized, meaningful health knowledge, potentially having a significant impact on health practices in communities where health departments are not actively engaged. Fog computing and the IoT are crucial components of today's healthcare system, facilitating the management of vast amounts of big data for disease prediction and diagnosis. However, there is a risk of incorrect diagnosis when a patient has multiple illnesses. This paper aims to develop a model for the diagnosis of cardiovascular diseases and diabetes using a combination of AI and IoT approaches. The proposed model encompasses data collection, preprocessing, classification, and parameter setting. Wearables and sensors, which are part of the IoT, facilitate easy data collection, while artificial intelligence methods use this data for disease detection. As an example of intelligent healthcare systems, the proposed approach employs the Smart Healthcare-Crow Search Optimization (SH-CSO) algorithm to diagnose diseases. By adjusting the “weight” and “bias” parameters of the intelligent healthcare systems model, CSO enhances the classification of medical data. The application of CSO significantly improves the diagnostic outcomes of the intelligent healthcare systems model. The efficacy of the SH-CSO algorithm was validated using medical records. Results demonstrated that the proposed SH-CSO model could diagnose diabetes with a maximum accuracy of 97.26% and heart disease with a maximum accuracy of 96.16%. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Disease Diagnosis; Feature Extraction; Iot-fog; Smart Healthcare; Cardiology; Data Acquisition; Data Handling; Diagnosis; Diseases; Fog; Fog Computing; Health Care; Information Management; Metadata; Data Collection; Disease Diagnosis; Features Extraction; Healthcare Systems; Internet Of Thing-fog; Maximum Accuracies; Optimization Algorithms; Search Optimization; Smart Healthcare; System Models; Internet Of Things},
