	affiliations = {Scuola Normale Superiore di Pisa, Pisa, Italy; Università di Pisa, Pisa, Italy; University of Southampton, Southampton, United Kingdom; Centre for Research and Technology-Hellas, Thessaloniki, Greece; Freie Universität Berlin, Berlin, Germany; Gottfried Wilhelm Leibniz Universität Hannover, Hannover, Germany; Free University of Bozen-Bolzano, Bolzano, Italy; Universität Klagenfurt, Klagenfurt, Austria; Leibniz Institute for the Social Sciences GESIS, Mannheim, Germany; Rheinisch-Westfälische Technische Hochschule Aachen, Aachen, Germany; The Open University, Milton Keynes, United Kingdom; KU Leuven, Leuven, Belgium; SCHUFA Holding AG, Hannover, Germany},
