	keywords = {Artificial intelligence; Curricula; Decision support systems; Energy balance; Multitasking; Open source software; Problem oriented languages; Program debugging; Quality management; Syntactics; Teaching; Assessment tool; Automated assessment; Automated assessment tool; Automated grading; Computer Science course; CSI; Fine tuning; Introductory computer science; Language model; Large language model; Students},
	publisher = {Institute of Electrical and Electronics Engineers Inc.},
