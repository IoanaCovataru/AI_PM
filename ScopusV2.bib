	keywords = {Chemical detection; Database systems; Deep learning; E-learning; Frequency estimation; Learning algorithms; Learning systems; Network architecture; Optical radar; Risk management; Risk perception; 3D point cloud; Change detection; Digital rockfall database; Learning architectures; Light detection and ranging; Machine-learning; Neural-networks; Risks management; Rock slope; Rockfalls; Classification (of information)},
	publisher = {Elsevier B.V.},
	issn = {00137952},
