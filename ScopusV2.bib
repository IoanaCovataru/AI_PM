	title = {AI-Empowered Peatland Management for Climate-Resilient and Sustainable Future: Challenges and Opportunities},
	year = {2024},
	pages = {},
	doi = {10.1109/eSmarTA62850.2024.10638930},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85203677909&doi=10.1109%2FeSmarTA62850.2024.10638930&partnerID=40&md5=c3a9182d600f4f8bef62be966eb063cb},
	affiliations = {University of Galway, Galway, Ireland; Technological University of the Shannon: Midlands Midwest (TUS), Limerick, Ireland; Shenyang Aerospace University, Shenyang, China; Ibb University, Faculty of Engineering, Ibb, Yemen},
	abstract = {Peatlands are crucial for preserving biodiversity, controlling temperatures and storing carbon on a scale. The vital ecological systems face threats from the degradation of land and deforestation, which leads to impacts of climate change, while Artificial Intelligence (AI) plays a vital role in effectively addressing the challenges. By exploring how AI supports monitoring peatlands and climate change, we propose a novel framework that integrates AI and peatland management in order to bolster climate resilience and sustainability efforts based on evidence. Therefore, policymakers can improve the peatland restoration, monitoring and conservation programs by leveraging AI for data analysis, predictive modelling and decision-making processes. AI enables real-time tracking of peatland conditions, detecting activities and wildfires, and optimizing land management strategies. Through the presentation of case studies and best practices, this study underscores how incorporating AI-driven policies for peatland management can strengthen ecosystem sustainability and climate resilience. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Biodiversity; Carbon Sequestration; Climate Change; Climate Resilience; Land Degradation; Sustainability; Carbon Capture And Utilization; Carbon Sequestration; Climate Resilience; Ecological Systems; Future Challenges; Intelligence Support; Land Degradation; Monitoring Programmes; Peat Land; Policy Makers; Restoration Project},
