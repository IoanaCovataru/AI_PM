	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85087619249&doi=10.1007%2Fs40095-020-00352-2&partnerID=40&md5=befc94f990a430906c92c0dd6430f2fc},
	affiliations = {Universiti Brunei Darussalam, Institute of Applied Data Analytics, Bandar Seri Begawan, Brunei Darussalam; Universitetet i Agder, Faculty of Engineering and Science, Kristiansand, Norway},
	abstract = {Power developed by the wind turbines, at different wind velocities, is a key information required for the successful design and efficient management of wind energy projects. Conventionally, for these applications, manufacturer’s power curves are used in estimating the velocity–power characteristics of the turbines. However, performance of the turbines under actual field environments may significantly differ from the manufacturer’s power curves, which are derived under ‘standard’ conditions. In case of existing wind projects with sufficient performance data, the velocity–power variations can better be defined using artificially intelligent models. In this paper, we compare the performance of four such models by applying them to a 2-MW onshore wind turbine. Models based on ANN, KNN, SVM and MARS were developed and tested using the SCADA data collected from the turbine. All the AI models performed significantly better than the manufacturer’s power curve. Among the AI methods, SVM-based predictions showed the highest accuracy. A site-specific performance curve for the turbine, based on the SVM model, is presented. Wider adaptability of this approach has been demonstrated by successfully implementing the model for a 3.6-MW wind turbine, working under offshore environment. Being “site-specific data” driven, the proposed models are more accurate and hence better choice for applications like short-term wind power forecasting and pro-diagnostics of wind turbines. © 2021 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Data-driven Models; Power Curve; Wind Power Forecasts; Wind Turbine Prognostics; Artificial Intelligence; Manufacture; Offshore Oil Well Production; Wind Power; Efficient Managements; Intelligent Models; Offshore Environments; Onshore Wind Turbine; Performance Curve; Power Characteristic; Short-term Wind Power Forecasting; Wind Energy Projects; Wind Turbines},
