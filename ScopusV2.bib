	doi = {10.1007/978-3-031-60049-4_7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105001746642&doi=10.1007%2F978-3-031-60049-4_7&partnerID=40&md5=55828624e4523c866e14fe098e75dcd9},
