}

@ARTICLE{Kanyilmaz2022,
	author = {Kanyilmaz, Alper and Tichell, Patricia Raquel Navarro and Loiacono, Daniele},
	title = {A genetic algorithm tool for conceptual structural design with cost and embodied carbon optimization},
	year = {2022},
