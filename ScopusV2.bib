@ARTICLE{Zarghami20238,
	author = {Zarghami, Seyed Ashkan},
	title = {Accommodating Uncertainty in Forecast Generation of Artificial Intelligence Tools in Construction Projects},
	year = {2023},
	pages = {8 - 11},
	doi = {10.1109/ICACEH59552.2023.10452587},
