@CONFERENCE{Caccavale2023112,
	author = {Caccavale, Riccardo and Di Maio, Ernesto D. and Finzi, Alberto and Fontanelli, Andrea Giuseppe and Loianno, Valerio and Villone, Massimiliano Maria},
	title = {An Autonomous Robotized Cell for Polymer Foaming},
