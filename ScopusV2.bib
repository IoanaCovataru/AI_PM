	title = {STUDENT PROJECT COMMUNITIES BIG DATA ANALYSIS IN WORKING WITH KNOWLEDGE SYSTEMS COGNITIVE VISUALIZATION; АНАЛИЗ БОЛЬШИХ ДАННЫХ ПРОЕКТНЫХ СТУДЕНЧЕСКИХ СООБЩЕСТВ В РАБОТЕ СО ЗНАНИЕВЫМИ СИСТЕМАМИ: КОГНИТИВНАЯ ВИЗУАЛИЗАЦИЯ},
	year = {2024},
	journal = {Praxema},
	volume = {190},
