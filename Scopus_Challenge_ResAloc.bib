	language = {English},
	abbrev_source_title = {Proc. - IEEE Int. Conf. Softw. Maint. Evol., ICSME},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 5}
}

