@CONFERENCE{Squillace20241760,
	author = {Squillace, Joseph and Cappella, Justice and Sepp, Andrew},
	title = {User Vulnerabilities in AI-Driven Systems: Current Cybersecurity Threat Dynamics and Malicious Exploits in Supply Chain Management and Project Management},
	year = {2024},
	pages = {1760 - 1765},
	doi = {10.1109/ICETSIS61505.2024.10459480},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85190558628&doi=10.1109%2FICETSIS61505.2024.10459480&partnerID=40&md5=f7c18e0e87670a0b7a64043c230d6501},
	affiliations = {Penn State Schuylkill, Cybersecurity Analytics and Operations, Schuylkill Haven, United States; Penn State Schuylkill, Business Management and Marketing, Schuylkill Haven, United States},
	abstract = {In today's interconnected digital ecosystem, Artificial Intelligence (AI) and Machine Learning (ML) stand at the forefront of innovation, efficiency, and resource management. However, the rapid ascension of AI and ML technologies that provide a foundation of groundbreaking capabilities need to be protected. Moreover, techniques that make AI and ML effective, efficient, and a force multiplier within the computing domain, and the central tenets of modern AI and ML technological advancement positioning them as the future of tomorrow, need to be safeguarded against exploitation and abuse by threat actors. Based on their ubiquity, embedded use of AI and ML within industry faces a major paradox; as AI and ML technologies empower and streamline operations while providing transformative benefits to users, they simultaneously introduce formidable threats through security vulnerabilities that can cause massive damage if not defended against. This discourse delves into cybersecurity vulnerabilities inherent to AI and ML implementations within critical infrastructure domains of supply chain management and project management to explore how these weaknesses may be exploited. Further, we discuss ways AI and ML can be exploited by cybersecurity vulnerabilities within industry to compromise data and resources. Through a focused, multiple case study, we identify a serious flaw within AL and ML needing further investigation, identify data needing further examination, and isolate specific cybersecurity threats associated with AI and ML in supply chain management and project management, including exploitation of user vulnerabilities, use of AI and ML to bypass security measures, and use of AI and ML to automate attacks. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {artificial intelligence; critical infrastructure; cybersecurity; project management; supply chain management},
	keywords = {Artificial intelligence; Cybersecurity; Project management; Public works; Supply chain management; 'current; Artificial intelligence learning; Cyber security; Digital ecosystem; Driven system; Efficiency managements; Innovation efficiency; Innovation management; Machine learning technology; Machine-learning; Critical infrastructures},
