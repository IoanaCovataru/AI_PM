@CONFERENCE{Zhao2023743,
	author = {Zhao, Wenbo},
	title = {Implementation of Using AI to Manage Known and Unknown Risks in Risk Management},
	year = {2023},
	pages = {743 - 749},
	doi = {10.1145/3656766.3656890},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85195259467&doi=10.1145%2F3656766.3656890&partnerID=40&md5=5d4a5519c27798782a20bf7724f648c7},
	affiliations = {Boston University Metropolitan College, Boston, United States},
	abstract = {This paper provides insights into a new methodology for monitoring and predicting known and unknown risks in the field of risk management in project management through Artificial Intelligence (AI). The novel methodology can significantly reduce the difficulty of using AI for risk management and thus maximize its spread in the private sector. A mathematical model is built by using AI to quickly screen potential risk factors and quickly determine the degree of correlation between each influencing factor and the observed risk. The AI is then used to continuously observe the influencing factors over a certain period of time, and the mathematical model is used to calculate the possible trend of the risk, and ultimately to know the exact impact of the risk before it arrives, and to prepare for the execution of the project. According to the case simulation, using this methodology, it was concluded that over the next year, the U.S. Steel Index would continue to decline until it reached a low of 630.61 in April, but rebounded to 1,428.95 just one month later, an increase of about 126%, with no significant downward trend in the coming months. Therefore, the project manager can avoid overspending the project budget by saving as much as possible before this risk arises, or by purchasing materials in advance. In addition, by forecasting, the project manager can raise the urgency and danger of the risk to the stakeholders, and obtain support for project changes in advance of the risk. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Big Data; Data Analytics; Data Modeling; Project Management; Risk Management},
