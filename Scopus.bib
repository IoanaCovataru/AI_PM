@ARTICLE{Sahane202561,
	author = {Sahane, Prema Bhushan and Shimbre, Nivedita and Shravage, Chetana and Singh, Rahul and Pukale, Neha and Waghmare, Anuja and Sukale, Vaibhav},
	title = {Smart Campus Solutions: Leveraging AI-ML Technologies for Integrated Campus Management Platform},
	year = {2025},
	journal = {Lecture Notes in Networks and Systems},
	volume = {1254},
	pages = {61 - 77},
	doi = {10.1007/978-981-96-1744-9_7},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007987592&doi=10.1007%2F978-981-96-1744-9_7&partnerID=40&md5=46cca1378a12529f9445143f43bc2f67},
	affiliations = {Rajarshi Shahu College of Engineering, Department of Computer Engineering, Pimpri-Chinchwad, India; Dr. D. Y. Patil Institute of Technology, Pune, India},
	abstract = {Effective management of college operations is essential for the success of colleges in today's education. This study presents a project to develop the Integrated Campus Management Platform (ICMP) using Artificial Intelligence—Machine Learning (AI-ML) technology. The platform not only facilitates the management of activities, such as student management, property management, and academic planning, but also supports general education. Using AI-ML, the system can adapt to changing situations and provide rapid insights, making it an important tool for informed decision-making. ICMP is designed not only as a management tool, but also as a force for change, strengthening all education in college. Thanks to the intelligent use of artificial intelligence-machine learning technology, the platform becomes an adaptable system that can respond to the changing environment. This change ensures that the platform remains at the forefront of technological developments and continues to provide up-to-the-minute information to stakeholders. © 2025 Elsevier B.V., All rights reserved.},
