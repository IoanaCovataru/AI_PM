	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105006515080&partnerID=40&md5=46991455ab2aac3cabb5e8a7520ac6dd},
	affiliations = {},
	abstract = {Globally, food security has become a severe issue with the increase in world population. To meet the needs of a growing population, the agricultural sector has to increase food production from a smaller area of arable land by using natural resources more efficiently and with minimal environmental damage. Malaysia is not a food-secure nation and ranks 41 on the Global Food Security Index. Since the beginning of agriculture, a threat from unfavorable biotic and abiotic factors has reduced crop production. Weeds are the most important of the biotic limiting factors. Weeds always affect crop productivity due to their competition with crops for water, nutrients, light, carbon dioxide, and space. Infestations of weeds are well-acknowledged as a significant biological limitation on crop yield across all agroecosystems and seasons. However, high labor costs have led to a decline in the use of conventional manual weeding methods, and this trend has been mirrored worldwide by an increase in synthetic herbicides. Continuous use of synthetic herbicides increases the possibility of herbicide resistance, environmental damage, contaminated agricultural goods, and adverse impacts on human health. Because of these issues, researchers are now interested in finding alternatives to synthetic pesticides. My research group launched several research projects to promote research toward sustainable weed management programs, especially in the fields of rice and plantation, that could reduce weed infestation and competition over time and less dependence on herbicides. Weed surveys were conducted in different areas, especially rice, to determine the weed community and most dominant weed species. Knowing the distribution and severity of weed flora before taking action is necessary. There is no single solution for combating weed; therefore, our study includes developing and implementing more sustainable weed management that involves cultural, mechanical, biological, and efficient chemical herbicides and artificial intelligence (AI). Integrated weed management (IWM) systems provide more robust and long-term management of weeds that could potentially reduce herbicide use. Research in IWM must consider all aspects of the cropping system and evolve progressively. Our study using numerous sustainable strategies such as weed infestation survey, weed-suppressive crop varieties, manipulation of soil moisture, seeding date, seeding rate, row spacing, biological control, cover crops, the critical period of weed interference and allelopathy initiative have shown very positive results. Furthermore, our initial research about using artificial intelligence (AI) unmanned aerial vehicle (UAV) hyperspectral drones as tools for early weed detection has shown promising results. The initiative could lead to faster and more efficient weed management at the early stages, reducing weed competition and increasing yields. The outcome of these studies benefited conventional and organic growers by providing information regarding maintaining weed populations at manageable levels by sustainable weed management methods for environmentally friendly, economically viable, and socially acceptable agriculture systems, hence increasing food security. © 2025 Elsevier B.V., All rights reserved.},
	keywords = {Fruits; Pesticides; Seed; Agricultural sector; Environmental damage; Food production; Food security; Malaysia; Small area; Weed competition; Weed infestation; Weed management; World population; Weed control},
	publisher = {Universiti Putra Malaysia Press},
	isbn = {9786297590202},
	language = {English},
	abbrev_source_title = {Sustain. Weed Manag. to Enhance Food Secur. in Malays.},
	type = {Book},
