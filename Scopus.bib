	year = {2024},
	pages = {919 - 925},
	doi = {10.1109/ICPCSN62568.2024.00155},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85201717369&doi=10.1109%2FICPCSN62568.2024.00155&partnerID=40&md5=01639b4687c092d9a4f175c052955165},
	affiliations = {Karunya Institute of Technology and Sciences, Department of Computer Science and Engineering, Coimbatore, India; Alliance University, Department of CSE, Bengaluru, India; Karunya Institute of Technology and Sciences, Division of CSE, Coimbatore, India; Karunya Institute of Technology and Sciences, Division of AIML, Coimbatore, India; Karunya Institute of Technology and Sciences, Department of Computer Science and Engineering, Coimbatore, India},
	abstract = {Nowadays, the global challenge of ensuring food security for a growing population necessitates innovative solutions in agriculture. The convergence of Internet of Things (IoT) and Artificial Intelligence (AI) technologies presents a promising avenue for addressing key issues such as crop disease management and resource optimization. In that project proposes a holistic approach to smart agriculture by integrating IoT-based sensor systems for real-time monitoring of key agricultural parameters with AI-powered disease detection and severity estimation techniques. Leveraging advanced sensor technologies, including soil moisture, float level, pH, and humidity sensors, the proposed system collects real-time data from agricultural lands and transmits it to a cloud-based platform. Additionally, a deep learning-based Convolutional Neural Network (CNN) model is employed to detect and classify crop diseases from images captured in the field. The system further estimates disease severity by analyzing affected and unaffected leaf regions, enabling targeted treatment with appropriate pesticide concentrations. By combining IoT sensor data with AI-driven disease management. The integrated system offers a comprehensive solution for precision agriculture. Through early disease detection, optimized resource usage, and timely intervention, the proposed system aims to enhance crop yield, minimize wastage, and contribute towards global food security goals. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Disease prediction; Growth monitoring; Humidity management; pH detection},
	keywords = {Convolutional neural networks; Deep learning; Humidity control; Humidity sensors; Soil moisture; Crop disease; Disease management; Disease prediction; Disease severity; Growth monitoring; Humidity management; Monitoring system; Ocimum sanctum; pH detection; Plant growth; Smart agriculture},
