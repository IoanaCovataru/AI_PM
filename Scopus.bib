	affiliations = {St. Joseph's College of Engineering, Department of Computer Science and Engineering, Chennai, India},
	abstract = {With the growing need for error-free multilingual communication and information retrieval, artificial intelligence (AI)-enabled systems have cropped up to enable effective retrieval of texts and translation. This paper introduces a sophisticated AI-based framework incorporating Large Language Models (LLMs) for real-time text extraction and multilingual translation. The system provides for interactive dialogue with documents so that users can retrieve and translate English text into Tamil while keeping the context intact and ensuring accuracy. By leveraging OpenAI's GPT model, the system ensures high-quality translations that preserve semantic coherence, making it a valuable tool for education, content accessibility, and cross-linguistic communication. © 2025 Elsevier B.V., All rights reserved.},
