@CONFERENCE{Meschini202226,
	author = {Meschini, Silvia and Tagliabue, Lavinia Chiara and Di Giuda, Giuseppe Martino},
	title = {Leveraging Digital Twins to Enhance Green Public Procurement in AECO Industry},
	year = {2022},
	journal = {CEUR Workshop Proceedings},
	volume = {3285},
	pages = {26 - 38},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85143413486&partnerID=40&md5=42c0895d313b4b81ca4b927c5c2b7add},
	affiliations = {Politecnico di Milano, Built Environment and Construction Engineering, Milan, Italy; Università degli Studi di Torino, Department of Computer Science, Turin, Italy; Università degli Studi di Torino, Department of Management, Turin, Italy},
	abstract = {The digital transition of process management and Digital Twins (DTs) are promising to bridge the gap towards Product Lifecycle Management (PLM) and revolutionize decision-making processes in AECO (Architectural, Engineering, Construction and Operation) industry. Public procurement particularly suffers of poor digitalization with ineffective processes and low adoption of Green Public Procurement (GPP) mainly due to the lack of digital and automated data-driven tools for tender evaluation. Leveraging DTs as virtual Prototypes (DTPs) could help to overcome the current discrete project performances evaluation and enable a systemic one, exploitable for bids evaluation besides performance and sustainability optimization. The research adopts a PLM view to define a methodology aimed at developing DTPs starting from the bidding BIM models. The main objective is to integrate several DTPs and an Artificial Intelligence (AI) system in the aim automatizing MEAT (Most Economic Advantageous Tender) procedure and promote GPP adoption, providing an optimal and more objective data-driven awarding system and criteria weighting. Three crucial objectives should be accomplished: (i) the definition of a replicable methodology to develop the DTPs, (ii) the definition of their informative structure and (iii) the re-engineering of tender processes to bring full digitalization and automation. This could enable more effective decisions and performance optimization, bids objective evaluation, tendering procedure streamlining, transparency and sustainability enhancement. The awarded DTP, as a truthful “As-built” developed accordingly to defined information guidelines, must be exploited as the basis for valuable DTIs to manage the whole lifecycle, optimizing DTs development costs together with operational and maintenance costs. © 2022 Elsevier B.V., All rights reserved.},
