	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105018048793&doi=10.56294%2Fdm2025857&partnerID=40&md5=7c034a637408972cd22996b684eebba1},
	affiliations = {Institución Albera Salut, Peralada, Spain; Instituto Superior Politécnico “Alvorecer da Juventude” (ISPAJ), Luanda, Angola; Universidad Mayor de San Andrés, Institute of Genetics, La Paz, Bolivia; CRIT-Occidente, Guadalajara, Mexico; Centro Nacional de Genética Médica, Havana, Cuba; Centro Provincial de Genética Médica de Ciego de Avila, Cuba; Centro Provincial de Genética Médica de Villa Clara, Cuba; Hospital Materno Infantil Manuel Piti Fajardo, Mayabeque, Cuba; Especialista en genética clínica. Centro Provincial de Genética Médica Santiago de Cuba, Santiago, Cuba; Centro Provincial de Genética Médica de Artemisa, Cuba; Hospital Pediátrico Docente Juan Manuel Márquez, Havana, Cuba; Centro Provincial de Genética Médica de Sancti Spíritus. Cuba, Cuba; Servicio Municipal de Genética. Policlínico 26 de Julio, Mayarí, Cuba; Servicio Municipal de Genética Comunitaria, Alquízar, Cuba; Escuela Superior de Saúde Castelo (ESSCA), Luanda, Angola},
	abstract = {Introduction: advances in the field of Artificial Intelligence (AI) and Machine Learning (ML) have considerable potential to improve the diagnosis and management of rare genetic diseases, due to the human inability to memorize information on a multitude of these diseases, which AI tools could store, analyze and integrate. Objective: to develop and validate a new AI tool for the clinical diagnosis of genetic diseases. Method: a prospective, cross-sectional, analytical, observational study was conducted at the application level, with a qualitative-quantitative approach and contributing to a technological development project. It was characterized by four stages: selection of the AI tool, selection of the knowledge base, development of the virtual assistant, validation process and implementation in the clinic. Results: a total of 246 patients with genetic diseases and congenital defects were evaluated. The most predominant genetic category was monogenic genetic syndromes with 223 patients who attended the consultation (90,7 %). A success rate of 84,1 % was obtained and a success/no success ratio of 4,34. The highest percentage of successes was achieved in monogenic or Mendelian syndromes. There were no significant differences between successes and failures in both chromosomal aberrations and congenital defects of environmental etiology. Conclusions: through this research, an AI virtual assistant has been validated for the clinical diagnosis of genetic diseases with a high percentage of effectiveness of 84 %, which confirms its usefulness to support the clinical diagnosis of cases with genetic diseases. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial Intelligence; Diagnosis; Genetic Diseases; Rare Diseases; Virtual Assistant},
	keywords = {Computer aided diagnosis; Defects; Diseases; Information management; Knowledge based systems; Learning systems; Artificial intelligence learning; Artificial intelligence tools; Clinical diagnosis; Congenital defects; Genetic disease; Machine-learning; Observational study; Prospectives; Rare disease; Virtual assistants; Clinical research},
