@ARTICLE{Júnior2024792,
	author = {Júnior, George Hideyuki Kuroki and Gottschalg-Duque, Cláudio},
	title = {Towards Multimodal Information Architecture: A Social-Technical Approach of Artificial Intelligence Development in Inova HFA’s Electronic Health Record (EHR)},
	year = {2024},
	journal = {Lecture Notes in Networks and Systems},
