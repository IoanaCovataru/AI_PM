@ARTICLE{Lee2022,
	author = {Lee, Seojoon and Jeong, Minkyeong and Cho, Chung Suk and Park, Jaewon and Kwon, Soon Wook},
	title = {Deep Learning-Based PC Member Crack Detection and Quality Inspection Support Technology for the Precise Construction of OSC Projects},
	year = {2022},
