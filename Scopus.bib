@ARTICLE{Riedmann-Streitz20252491,
	author = {Riedmann-Streitz, Christine and Streitz, Norbert A. and Antona, Margherita and Marcus, Aaron and Margetis, George and Ntoa, Stavroula S.N. and Rau, Pei-Luen Patrick and Rosenzweig, Elizabeth},
	title = {How to Create and Foster Sustainable Smart Cities? Insights on Ethics, Trust, Privacy, Transparency, Incentives, and Success},
	year = {2025},
	journal = {International Journal of Human-Computer Interaction},
	volume = {41},
	number = {4},
	pages = {2491 - 2522},
	doi = {10.1080/10447318.2024.2325175},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-86000376435&doi=10.1080%2F10447318.2024.2325175&partnerID=40&md5=7e670d4c64de2489b8b3a2126a1e1742},
	affiliations = {MarkenFactory, Frankfurt am Main, Germany; Goethe-Universität Frankfurt am Main, Frankfurt am Main, Germany; Smart Future Initiative, Frankfurt am Main, Germany; Institute of Computer Science, Heraklion, Greece; Aaron Marcus and Associates, Inc., Berkeley, United States; Tsinghua University, Beijing, China; Bubble Mountain Consulting, Newton, United States; Brandeis University, Waltham, United States},
	abstract = {This paper describes the motivation, framework, concepts, method, implementation, and results of the HCII2023 Design Café, a dedicated participatory highly interactive design workshop held in Copenhagen in July 2023. Motivated by the ubiquitous challenges our world is facing, this initiative had the goal to explore six main issues from an interdisciplinary perspective with a focus on the UN SDG 11: “Sustainable Cities and Communities” and the HCI Grand Challenge 2 “Human-Environment Interactions.” The six issues were formulated as questions and presented to the participants working in small groups. (1) How to create inclusive and ethical smart cities? (2) How to establish trust between people and smart environments? (3) How to address privacy concerns in smart environments that adopt the “disappearing computer” paradigm? (4) How to promote explainability and transparency of policies and measures to citizens of smart cities or in smart environments in general? (5) How to design incentives and rewards for engagement and sustainable behavior in smart cities at a personal as well as collective/corporate level? (6) How to measure success and impact in sustainable smart city projects? The method and approach of the Design Café is a tailored composition of a guided, structured format combined with and inspired by processes of informal communication and exchange of knowledge and ideas. Aligned moderation, a minimum set of rules, a set of relevant topics and an interdisciplinary group of motivated participants working in rotating formations provides the structure for achieving results. The results show that the six issues are not independent of each other, but require a holistic view, considering the various dependencies as well as synergies when exploring solutions. Nevertheless, the importance of first establishing higher-level goals based on ethical and inclusive approaches fostering human dignity and human rights were key. Acceptance of overall goals, processes, rules, and regulations was considered as the fundamental pre-requisite for sustainable change towards a declared goal. Acceptance needs trust and privacy as well as explainability and transparency of policies and measures. The role of incentives and rewards for engagement and sustainable behavior was twofold. Offering incentives must include planning on how to measure their impact. Effective measurement of success and impact depends heavily on how the institutions address privacy. Explainability and transparency should become one of the ethical guidelines that steer and control concepts, decision making, and implementations of all activities. The scale of these societal challenges still needs to be recognized by those responsible. It is essential to educate decision makers in the psychological needs and effects of sense making, comprehensibility, and finally acceptance and well-being moving towards a humanity-centered design. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {artificial intelligence; cooperative city; design café; disappearing computer; ethics; explainability; explainable AI; HCI grand challenges; human- and citizen-centered design; human-centered AI; Human-environment interaction; humane city; humanity-centered design; incentives and rewards for sustainable behavior; inclusiveness; information design, knowledge design; measuring success and impact; observability; participatory design; privacy; quintuple helix; smart city; smart environments; sustainability; sustainable behavior; sustainable cities and communities; transparency; trust; UN SDGs},
	keywords = {Artificial intelligence; Data privacy; Ethical technology; Human computer interaction; Knowledge management; Smart city; Sustainable development; Cooperative city; Design cafe; Design knowledge; Disappearing computers; Explainability; Explainable AI; Grand Challenge; HCI grand challenge; Human- and citizen-centered design; Human-centered AI; Human-environment interaction; Humane city; Humanity-centered design; Incentive and reward for sustainable behavior; Inclusiveness; Information design; Information design, knowledge design; Measuring success and impact; Participatory design; Privacy; Quintuple helix; Smart environment; Sustainable behaviours; Sustainable cities; Sustainable communities; Trust; UN SDG; Transparency},
