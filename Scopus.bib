	author = {Hajirasouli, Aso and Banihashemi, Saeed and Drogemuller, Robin M. and Fazeli, Abdulwahed and Mohandes, Saeed Reza},
	title = {Augmented reality in design and construction: thematic analysis and conceptual frameworks},
	year = {2022},
	journal = {Construction Innovation},
	volume = {22},
