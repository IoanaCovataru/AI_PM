@CONFERENCE{Mohammadian2022161,
	author = {Mohammadian, Hamid Doost and Castro, Manuel Alonso and Wittberg, Volker},
	title = {Doost Sme Ranking Model (DSRM) for the Edu. SMEs Development, based on Guter Mittelstand, MOOCs & Related Projects as German Best Practice Towards: Future Edu Readiness to Achieve SME 5.0},
	year = {2022},
	pages = {161 - 178},
