	title = {UNRAVELING THE INFLUENCE OF ARTIFICIAL INTELLIGENCE, ORGANIZATIONAL, AND ENVIRONMENTAL FACTORS IN STRATEGIC PLANNING: IMPLICATIONS AND PRACTICAL INSIGHTS},
	year = {2024},
