	year = {2024},
	pages = {85 - 98},
	doi = {10.1201/9781003450610-8},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85210653951&doi=10.1201%2F9781003450610-8&partnerID=40&md5=6dc8b57b724aa5979c33fa572cb4ba81},
