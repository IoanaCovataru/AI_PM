	language = {English},
	abbrev_source_title = {Proc. - Int. Conf. Emerg. Innov. Adv. Comput., INNOCOMP},
	type = {Conference paper},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 4}
}

