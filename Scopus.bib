	doi = {10.1080/08874417.2025.2564440},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105019324549&doi=10.1080%2F08874417.2025.2564440&partnerID=40&md5=584c3232e03617170059f7a2fb68789b},
	affiliations = {Kookmin University, Graduate School of Business IT, Seoul, South Korea; HJ Institute of Technology and Management, Seoul, South Korea},
	abstract = {As companies embrace artificial intelligence (AI), they are shifting from digital transformation to AI-centric innovation. This study explores the factors influencing AI project success within organizations, focusing on two key elements: data availability and quality, and AI strategy aligned with business needs. Using a survey of 249 completed AI projects and analyzed with SmartPLS 4.0, the study found that AI strategy was a stronger success factor than data quality. Top management support, project champions, and interdepartmental collaboration also played significant roles, with top management support being the most critical. The findings emphasize the importance of strategy and domain knowledge over data and infrastructure, offering valuable insights for organizations and stakeholders involved in AI projects. This research also supports government efforts to promote AI adoption. © 2025 Elsevier B.V., All rights reserved.},
