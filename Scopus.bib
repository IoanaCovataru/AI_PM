	keywords = {Accident prevention; Architectural design; Eye tracking; Life cycle; Project management; Serious games; Virtual reality; Wearable technology; Construction safety; Emerging technologies; Eye-tracking; Safety performance; Safety planning; Safety training; Structural modeling; Technology adoption; Virtual reality devices; Wearable devices; Construction industry},
