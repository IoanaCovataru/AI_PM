	doi = {10.1109/ISEC64801.2025.11147425},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105017709156&doi=10.1109%2FISEC64801.2025.11147425&partnerID=40&md5=b68fc280a9087ffc0c8a962caf6be37a},
	affiliations = {New York University, New York, United States},
	abstract = {The rapid evolution of technology has transformed industries worldwide, revealing critical gaps in traditional educational approaches, particularly in STEM (Science, Technology, Engineering, and Mathematics) including in the field of product development. Traditional academic frameworks often struggle to keep pace with industry demands, leaving some students underprepared for real-world challenges. This study identifies three core issues within STEM education: how to update curricula that lag technological advancements, limited opportunities for practical, hands-on application of skills, and constrained academic timeframes that limit the depth of transformative learning experiences.To address these issues, this research explores the integration of Artificial Intelligence (AI) tools and Agile methodologies to bridge the gap between academic theory and industry practice in the field of product development. By examining two case studies - the development of an AI-driven media analysis tool for the United Nations International Computing Centre (UNICC) and AI-focused capstone projects within a Management and Systems graduate program. We show how applying Generative AI and Agile technologies can enhance curriculum relevance, expand real-world skill development opportunities, and optimize learning within semester-based time constraints. AI enables adaptive, personalized learning and automates routine tasks, while Agile's iterative approach fosters engagement and adaptability in real-world problem-solving scenarios. AI is also a productive basis for product development in the integrative experience of a capstone. This research shows how combining AI and Agile provides an integrated framework for modernizing educational practices, equipping students with essential industry-relevant skills for a technology-driven workforce. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Agile Methodologies; Artificial Intelligence (AI); Generative AI; ProjectBased Learning; STEM Education; Technology Management},
	keywords = {Agile manufacturing systems; Computation theory; Curricula; Education computing; Engineering education; Industrial research; Personnel; Product development; Project management; Research and development management; STEM (science, technology, engineering and mathematics); Students; Agile Methodologies; Artificial intelligence; Engineering and mathematics; Generative artificial intelligence; Mathematics education; Project based learning; Science education; Science technologies; Technology education; Technology managements; Problem solving},
