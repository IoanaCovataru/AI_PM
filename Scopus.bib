	doi = {10.1109/ICARC64760.2025.10963119},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105004553346&doi=10.1109%2FICARC64760.2025.10963119&partnerID=40&md5=487ebc61e5181dac4e00acbd4c535855},
