	doi = {10.1109/ICAMCS59110.2023.00021},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85186761021&doi=10.1109%2FICAMCS59110.2023.00021&partnerID=40&md5=6b656ae357d9f373593c6103938de1de},
