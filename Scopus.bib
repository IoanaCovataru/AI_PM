	title = {Can a troubleshooting AI assistant improve task performance in industrial contexts?},
	year = {2025},
	journal = {International Journal of Production Research},
	pages = {},
	doi = {10.1080/00207543.2025.2527368},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010444115&doi=10.1080%2F00207543.2025.2527368&partnerID=40&md5=17c058f9170d5ddb615f474e6d657d2f},
	affiliations = {ETH Zürich, Department of Management, Zurich, Switzerland},
	abstract = {Access to domain expertise is critical to problem-solving activities. This study investigates the role and usefulness of an AI-based troubleshooting assistant in the knowledge-intensive context of train commissioning. The authors developed a multilingual, user-centred chatbot using a Retrieval-Augmented Generation framework and a Large Language Model to provide real-time, project-specific troubleshooting support. A controlled field experiment with 19 commissioning technicians completing 173 tasks was conducted to evaluate the effect of the AI assistant. Results show that AI-assisted users significantly outperformed non-users in task performance. The benefits were more substantial among less experienced technicians, which emphasises the prospect of AI assistants in bridging skill gaps. Performance gains were also moderated by the AI attitudes and AI familiarity of technicians, suggesting that organisations should take these factors into account when striving to adopt AI assistants. The findings provide empirical evidence for the role of generative AI in scaling operational knowledge, enhancing worker performance, and improving the efficiency of engineering workflows. This study contributes to the discussion of the role of generative AI in problem-solving by demonstrating a novel application for frontline decision support in complex, high-variance industrial tasks. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {chatbot; Generative AI; knowledge management; large language model; retrieval-augmented generation; train commissioning},
	keywords = {Artificial intelligence; Chatbots; Domain expertise; Generative AI; Industrial context; Language model; Large language model; Problem-solving; Retrieval-augmented generation; Task performance; Train commissioning; Knowledge management},
	correspondence_address = {N. Löwhagen; Department of Management, Technology, and Economics, ETH Zurich, Zurich, Switzerland; email: nloewhagen@ethz.ch},
	publisher = {Taylor and Francis Ltd.},
	issn = {1366588X; 00207543},
