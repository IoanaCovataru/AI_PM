	volume = {13459},
	pages = {},
	doi = {10.1117/12.3052839},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105010418851&doi=10.1117%2F12.3052839&partnerID=40&md5=3f746115e831422ee2ee42c814e2f6db},
	affiliations = {College of Engineering, Columbia, United States},
	abstract = {Simulation plays an increasingly critical role in training, evaluating, and understanding artificial intelligence (AI) models by enabling the efficient and cost-effective synthesis of large, diverse datasets with accurate ground truth. In prior work, we introduced two formal languages, LSCENE and LCAP, for procedural scene generation and data collection, and demonstrated the use of large language models (LLMs) to translate human prompts into LSCENE. However, these languages impose a high cognitive workload, and our initial text-to-scene LLM lacked awareness of the SIM environment and was error prone. In this paper, we advance the state-of-the-art in three key areas. First, we present an LLM to expose all assets in a project. Second, we explore a single LLM and a society of LLMs for human-in-the-loop (HITL) text-to-scene generation. Finally, we introduce structured TypeScript-based outputs to facilitate error detection and correction through feedback. These contributions enhance the scalability and accuracy of text-to-scene generation while supporting manual LSCENE editing, when desired. We provide multiple examples that illustrate the capabilities, successes, and challenges associated with creating virtual environments that align with the intent of the user. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {AI; asset management; LLM; ML; procedural; simulation; text-to-scene; typescript},
	keywords = {Asset management; Cost effectiveness; Formal languages; Information management; Large datasets; Virtual reality; Assets management; Language model; Large language model; ML; Model-based OPC; Procedural; Scene generation; Simulation; Text to scenes; Typescript; Artificial intelligence},
