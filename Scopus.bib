@ARTICLE{Tian2025,
	author = {Tian, Kun and Zhu, Zicheng and Mbachu, Jasper I.C. and Moorhead, Matthew and Ghanbaripour, Amir Naser},
	title = {Artificial intelligence in construction risk management: a decade of developments, challenges, and integration pathways},
	year = {2025},
	journal = {Journal of Risk Research},
	pages = {},
	doi = {10.1080/13669877.2025.2512080},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-105007135229&doi=10.1080%2F13669877.2025.2512080&partnerID=40&md5=121ae80864bc4a4006b544e4c5c0399c},
	affiliations = {Bond University, Faculty of Society and Design, Gold Coast, Australia; Bond University, Centre for Comparative Construction Research, Gold Coast, Australia},
	abstract = {The increasing complexity and uncertainty of construction projects have driven a paradigm shift in risk management, with Artificial Intelligence (AI) emerging as a transformative tool. This systematic review examines 87 peer-reviewed studies published between 2014 and 2024, assessing the role of AI technologies—including machine learning (ML), natural language processing (NLP), knowledge-based reasoning (KBR), optimisation algorithms (OAs), and computer vision (CV)—across the construction risk management lifecycle. Using PRISMA guidelines and NVivo-based mixed-method analysis, the review identifies AI’s core functions in risk identification, assessment, response, and monitoring, while uncovering key barriers such as fragmented implementation, limited adaptability, and socio-organisational resistance. ML and CV dominate predictive and visual analysis, while NLP and KBR support compliance and rule-based decision-making; OAs optimise resource trade-offs. Despite increasing research, critical gaps persist, including fragmented AI integration, limited attention to implementation barriers, and underrepresentation of adaptive response and monitoring stages. This paper makes four specific contributions: (1) it offers a functional taxonomy that maps AI methods to distinct risk management tasks and phases; (2) it synthesizes technical, organisational, and ethical challenges hindering real-world AI adoption; (3) it introduces an integrated AI–risk management lifecycle framework that aligns AI capabilities with construction project needs; and (4) it extends classical risk epistemologies by embedding Beck’s, Power’s, and Aven’s perspectives into the discourse on AI governance. These contributions provide a structured foundation for advancing research and guiding practitioners toward responsible, resilient, and explainable AI deployment in high-stakes construction environments. © 2025 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial intelligence; construction management; risk management; systematic literature review},
	keywords = {Domain Knowledge; Expert systems; Knowledge engineering; Project management; Risk perception; Supervised learning; Construction management; Construction projects; Construction risk management; Knowledge-based reasoning; Language processing; Machine-learning; Natural languages; Optimization algorithms; Risks management; Systematic literature review; Risk management},
	correspondence_address = {K. Tian; Faculty of Society & Design, Bond University, Gold Coast, Australia; email: kun.tian@student.bond.edu.au},
	publisher = {Routledge},
	issn = {13669877; 14664461},
	language = {English},
	abbrev_source_title = {J. Risk Res.},
	type = {Review},
	publication_stage = {aip},
	source = {Scopus},
	note = {Cited by: 1}
}

