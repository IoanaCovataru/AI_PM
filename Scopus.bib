	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85187678866&doi=10.1007%2F978-3-031-50495-2_9&partnerID=40&md5=7ad3bd3e4f7f04df96b931f94387a32e},
	affiliations = {Universidad Católica del Norte, Antofagasta, Chile},
	abstract = {Taking advantage of accumulated knowledge and lessons learned at the project level is essential to improving efficiency, making informed decisions and optimizing results. In this context, this study is presented through a system that seeks to collect and store valuable information generated during the project life cycle and will also use advanced analysis and machine learning techniques to extract significant knowledge. Its main objective is to provide professionals and project teams with an efficient and accessible tool to access lessons learned, best practices, and recommendations, thus facilitating informed decision-making and avoiding repeating mistakes. These goals are achieved with a robust and scalable architecture, integrating various data sources, such as project reports, technical documentation, historical data, and the experience of project consultants, to build a centralized repository of knowledge. In addition, the technical feasibility of natural language processing and machine learning algorithms to analyze, classify and label the stored information will be evaluated, allowing a precise search and an enriching user experience. The design of the AI system implies not only the implementation of advanced technological infrastructure but also the definition of a framework for the capture, validation, and continuous updating of the knowledge generated by the projects, promoting a culture of organizational learning where users will be encouraged to share their experiences and good practices, thus enriching the system and benefiting the project community as a whole. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {Artificial intelligence; Good practices; Knowledge management; Lessons learned; Project management},
