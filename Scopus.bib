	language = {English},
	abbrev_source_title = {J. King Saud Univ. - Comput. Inform. Sci.},
	type = {Article},
	publication_stage = {Final},
	source = {Scopus},
	note = {Cited by: 10; All Open Access; Hybrid Gold Open Access}
}

