@CONFERENCE{Viharika20241311,
	author = {Viharika, Sadargari and N, Alangudi Balaji},
	title = {AI Approach for Intrusion Detection and Resource Management Using Backpropagation Neural Network and Genetic Algorithm in Cloud Computing},
	year = {2024},
	pages = {1311 - 1316},
	doi = {10.1109/ICACCS60874.2024.10716917},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85208643098&doi=10.1109%2FICACCS60874.2024.10716917&partnerID=40&md5=c8219038ed09a6e3c2d53f452dc9f2c7},
	affiliations = {K L Deemed to be University, Department of Computer Science and Engineering, Vaddeswaram, India},
	abstract = {The security of data and apps stored on the cloud must be guaranteed due to the growing reliance on cloud computing. The goal of this project is to create an Intrusion Detection System (IDS) that is only intended to be used in cloud environments, using Artificial Intelligence (AI). A machine learning model trained on the NSL-KDD dataset enhances the algorithm's capacity to distinguish between likely intrusions and legitimate network traffic. This research provides a novel approach that combines a hybrid backpropagation neural network with a genetic algorithm for cloud-based intrusion detection systems (IDS). The hybrid model will be more accurate and resilient in recognizing various types of intrusions by merging the best aspects of both methods. The backpropagation neural network serves as the foundation for understanding complex patterns in the dataset, while the evolutionary algorithm improves the model parameters for improved performance. The proposed methodology has potential, with an impressive 97.65% accuracy rate. This high degree of accuracy demonstrates how well cloud environments can detect and address any security threats using the hybrid neural network and genetic algorithm method. The study's conclusions address the expanding problems caused by cyber attacks on cloud computing and advance the creation of AI -powered security measures. © 2024 Elsevier B.V., All rights reserved.},
	author_keywords = {AI; Backpropagation neural network; Genetic algorithm; IDS; NSL-KDD},
	keywords = {Cloud platforms; Cloud security; Genetic algorithms; Back-propagation neural networks; Backpropagation neural network algorithms; Cloud environments; Cloud-computing; Intrusion Detection Systems; Intrusion-Detection; Machine learning models; Neural networks and genetic algorithms; NSL-KDD; Resource management; Network intrusion},
